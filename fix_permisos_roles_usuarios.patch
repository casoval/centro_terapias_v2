+(function () {
+    const bloqueRoles = document.getElementById('bloque-roles');
+    const bloqueUsuarios = document.getElementById('bloque-usuarios');
+    if (!bloqueRoles && !bloqueUsuarios) return; // no es admin, no existen estos bloques
+
