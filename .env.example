# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env real a git (ya está en .gitignore).

# --------------------------------------------------
# ENTORNO
# --------------------------------------------------
ENVIRONMENT=development
# En producción: ENVIRONMENT=production (y ahí SECRET_KEY y las
# credenciales de Cloudinary pasan a ser obligatorias, sin valor por defecto)

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com

# --------------------------------------------------
# BASE DE DATOS (producción; en desarrollo se usa SQLite local)
# --------------------------------------------------
DATABASE_URL=postgres://usuario:password@host:5432/nombre_db
# Alternativa por variables sueltas (si no usas DATABASE_URL):
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=5432

# --------------------------------------------------
# CLOUDINARY (fotos de pacientes/profesionales)
# --------------------------------------------------
# Requerido también en desarrollo desde que se corrigió el hardcodeo de
# credenciales de ejemplo en settings.py. Usa tu propia cuenta gratuita
# de Cloudinary para desarrollo local.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --------------------------------------------------
# CLOUDFLARE R2 (documentos/informes de pacientes)
# --------------------------------------------------
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT_URL=

# --------------------------------------------------
# WEBHOOK (bot de WhatsApp / integraciones del agente)
# --------------------------------------------------
WEBHOOK_SECRET_TOKEN=genera-un-token-largo-y-aleatorio

# --------------------------------------------------
# AGENTE / IA
# --------------------------------------------------
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
INWORLD_API_KEY=
INWORLD_VOICE_ID=

# --------------------------------------------------
# BACKUPS / NOTIFICACIONES POR EMAIL
# --------------------------------------------------
BACKUP_DIR=
BACKUP_KEEP_LOCAL=
BACKUP_COMPRESS_LEVEL=
BACKUP_EMAIL_DESTINO=
BACKUP_GMAIL_USER=
BACKUP_GMAIL_APP_PASS=
EMAIL_RRHH=
