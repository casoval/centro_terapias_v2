+<script>
+document.getElementById('id_archivo').addEventListener('change', function (e) {
+    const span = document.getElementById('nombre-archivo-elegido');
+    if (e.target.files.length > 0) {
+        span.textContent = e.target.files[0].name;
+        span.classList.remove('text-slate-400');
+        span.classList.add('text-slate-800', 'font-bold');
+    } else {
+        span.textContent = 'Ningún archivo seleccionado';
+        span.classList.add('text-slate-400');
+        span.classList.remove('text-slate-800', 'font-bold');
