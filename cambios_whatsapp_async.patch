+def _enviar_whatsapp_en_background(url, payload):
+    """
+    ⚡ OPTIMIZACIÓN: se ejecuta en un hilo aparte para no bloquear la
+    respuesta al usuario mientras se espera al bot de WhatsApp (hasta 10s
+    en el peor caso: bot lento, caído, o problema de red). Marcar una
+    sesión como "falta"/"permiso" es una acción rutinaria diaria — antes,
+    si el bot tardaba, el navegador se quedaba "congelado" ese tiempo
+    completo antes de confirmar que la sesión se guardó.
+
+    No requiere Celery ni ninguna cola de tareas (el proyecto no tiene
+    ninguna configurada todavía, "sin Celery por ahora" según el propio
+    código) — es la mejora más simple y seria disponible hoy sin agregar
+    infraestructura nueva. Si se agrega Celery más adelante, esta función
+    es el candidato natural para convertirse en una @shared_task.
+
+    Nota: al ser un hilo daemon, si el proceso de gunicorn se reinicia
+    justo en medio del envío, el hilo se corta sin completar — el mismo
+    riesgo que ya existía antes (el código original tampoco reintentaba
+    ni garantizaba la entrega), así que esto no empeora la confiabilidad,
+    solo elimina la espera bloqueante.
+    """
+    try:
+        requests.post(url, json=payload, timeout=10)
+    except Exception as e:
+        # ⚡ Antes este error se descartaba en silencio (except: pass), sin
+        # ningún registro — si el bot fallaba, nadie se enteraba de que el
+        # aviso al tutor no se envió. Ahora queda registrado en el log.
+        logger.warning(
+            f"No se pudo enviar notificación de WhatsApp a "
+            f"{payload.get('telefono', '?')} (paciente {payload.get('paciente', '?')}): {e}"
+        )
+
+
 # Control en memoria para evitar mensajes duplicados por la misma sesion
 _sesiones_notificadas = set()
 
